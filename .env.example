# Copy to `.env` and fill in the real values. `.env` is gitignored — never commit it.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------------------
# PostgreSQL — local, via docker-compose.yml
# ---------------------------------------------------------------------------
# These three feed BOTH the container and DATABASE_URL below. If you change one,
# change it in DATABASE_URL too — Compose does not rewrite the URL for you.
POSTGRES_USER=hsk
POSTGRES_PASSWORD=hsk_local_dev
POSTGRES_DB=hsk_dev

# Host port only. Inside the container Postgres always listens on 5432.
# Change this (e.g. 5433) if you already run Postgres natively on Windows.
POSTGRES_PORT=5432

DATABASE_URL="postgresql://hsk:hsk_local_dev@localhost:5432/hsk_dev?schema=public"

# ---------------------------------------------------------------------------
# MongoDB — Atlas (online)
# ---------------------------------------------------------------------------
# From Atlas: Connect > Drivers > Node.js. Replace <PASSWORD> with the database
# user's password, and append the database name before the `?`.
#
# If the password contains @ : / ? # [ ] it MUST be percent-encoded, otherwise
# the URI parser truncates it and you get an auth error that looks like a wrong
# password. Easiest fix: use a password without those characters.
MONGODB_URI="mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/hsk_dev?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
