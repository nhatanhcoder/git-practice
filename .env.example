# Copy to `.env` and fill in the real values. `.env` is gitignored — never commit it.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------------------
# PostgreSQL — local, via docker-compose.yml
# ---------------------------------------------------------------------------
# These three feed BOTH the container and DATABASE_URL below. If you change one,
# change it in DATABASE_URL too — Compose does not rewrite the URL for you.
POSTGRES_USER=hsk
POSTGRES_PASSWORD=hsk_local_dev
POSTGRES_DB=hsk_dev

# Host port only. Inside the container Postgres always listens on 5432.
# Change this (e.g. 5433) if you already run Postgres natively on Windows.
POSTGRES_PORT=5432

DATABASE_URL="postgresql://hsk:hsk_local_dev@localhost:5432/hsk_dev?schema=public"

# ---------------------------------------------------------------------------
# MongoDB — Atlas (online)
# ---------------------------------------------------------------------------
# From Atlas: Connect > Drivers > Node.js. Replace <PASSWORD> with the database
# user's password, and append the database name before the `?`.
#
# If the password contains @ : / ? # [ ] it MUST be percent-encoded, otherwise
# the URI parser truncates it and you get an auth error that looks like a wrong
# password. Easiest fix: use a password without those characters.
MONGODB_URI="mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/hsk_dev?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001

# URL prefix every route is served under (main.ts setGlobalPrefix).
# Keep it in sync with NEXT_PUBLIC_API_URL below — the frontend builds its base
# URL from that variable, and the refresh-token cookie path is derived from this
# prefix (see KNOWN_ISSUES API-015: the cookie path is currently hardcoded and
# will be derived from API_PREFIX in the approved follow-up change).
# No leading slash.
API_PREFIX=api/v1

# Who may call the API (main.ts enableCors). Default http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth — values the code actually reads (closes API-005)
# ---------------------------------------------------------------------------
# REQUIRED. The API refuses to boot without it (app.module.ts JwtModule factory
# and AuthService constructor both fail fast). Use a long random string in
# production, e.g. openssl rand -hex 32.
JWT_ACCESS_SECRET=change-me-dev-secret

# Access-token TTL as accepted by jsonwebtoken (e.g. 15m, 1h).
# Default in code: 15m (auth.service.ts).
JWT_ACCESS_TTL=15m

# NOT read by the code today — kept out on purpose:
#   JWT_REFRESH_SECRET   refresh tokens are opaque random strings, only the
#                        SHA-256 hash is stored (auth.service.ts hashToken).
#   JWT_REFRESH_TTL      fixed at 7 days in code (REFRESH_TOKEN_TTL_MS).
#   BCRYPT_ROUNDS        fixed at cost 12 in code (INV-AUTH-01).
#   COOKIE_DOMAIN/COOKIE_SECURE  the cookie sets Secure from NODE_ENV
#                        (auth.controller.ts cookieOptions).
# If you need one of these to become configurable, that is a code change first.

# ---------------------------------------------------------------------------
# Gemini AI — shared platform key (ADR-014)
# ---------------------------------------------------------------------------
# Read by the dashboard monitoring service to report Gemini health
# (monitoring.service.ts). Optional; without it Gemini reports degraded.
GEMINI_API_KEY=placeholder

# ---------------------------------------------------------------------------
# Web (apps/web) — copy these into the app's .env.local / hosting env
# ---------------------------------------------------------------------------
# Base URL the frontend calls (apps/web/src/lib/api-client.ts).
# Must end with the same prefix as API_PREFIX above.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

